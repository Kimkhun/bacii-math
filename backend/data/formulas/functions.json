    "weight": 1,
    "group": "functions",
    "formulas": [
      "\\lim_{x\\to a^\\pm} f(x) = \\pm\\infty \\Rightarrow x=a \\text{ vertical asymptote}"
    ]
  },
  "derivative_ln": {
    "name_en": "Derivative of a logarithm",
    "name_km": "ដេរីវេនៃអនុគមន៍លោការីត",
