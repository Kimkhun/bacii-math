  "parity_definition": {
    "name_en": "Even/odd function",
    "name_km": "អនុគមន៍គូ ឬសេស",
    "latex": "g(-x) = g(x) \\text{ even},\\quad g(-x) = -g(x) \\text{ odd}",
    "weight": 1,
    "group": "functions",
    "formulas": [
      "g \\text{ even } \\iff g(-x) = g(x)",
      "g \\text{ odd } \\iff g(-x) = -g(x)"
    ]
  },
  "vertical_asymptote": {
    "name_en": "Vertical asymptote",
    "name_km": "អាស៊ីមតូតឈរ",
