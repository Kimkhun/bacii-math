    "weight": 1,
    "group": "functions",
    "formulas": [
      "a(x)=0 \\text{ at } x=x_0 \\text{ bounds the sign intervals}"
    ]
  },
  "log_quotient_rule": {
    "name_en": "Log of a quotient",
    "name_km": "លោការីតនៃផលធៀប",
