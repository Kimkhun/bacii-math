  "complex_multiplication": {
    "name_en": "Multiply complex numbers",
    "name_km": "",
    "weight": 2,
    "group": "complex",
    "latex": "(a+bi)(c+di) = (ac-bd)+(ad+bc)i",
    "formulas": [
