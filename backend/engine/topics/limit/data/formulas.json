{
  "factoring_0_0": {
    "name_en": "Factor a 0/0 indeterminate form",
    "name_km": "ដាក់ជាផលគុណកត្តារាងមិនកំណត់ 0/0",
    "weight": 1,
    "group": "limit",
    "latex": "\\lim_{x\\to a}\\frac{(x-a)P(x)}{(x-a)Q(x)} = \\lim_{x\\to a}\\frac{P(x)}{Q(x)}",
    "formulas": [
      "x^2-a^2=(x-a)(x+a)",
      "x^3-a^3=(x-a)(x^2+ax+a^2)"
    ]
  },
  "rational_function_infinity": {
    "name_en": "Rational function at infinity",
    "name_km": "លីមីតអនុគមន៍សនិទាននៅអនន្ត",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim_{x\\to\\infty}\\frac{a_nx^n+\\cdots}{b_mx^m+\\cdots}",
    "formulas": [
      "n=m \\Rightarrow \\frac{a_n}{b_m}",
      "n<m \\Rightarrow 0",
      "n>m \\Rightarrow \\pm\\infty"
    ]
  },
  "rationalization_conjugate_finite": {
    "name_en": "Rationalise with the conjugate",
    "name_km": "គុណកន្សោមឆ្លាស់បំបាត់រ៉ាឌីកាល់",
    "weight": 2,
    "group": "limit",
    "latex": "\\frac{\\sqrt{A}-B}{C}\\cdot\\frac{\\sqrt{A}+B}{\\sqrt{A}+B} = \\frac{A-B^2}{C(\\sqrt{A}+B)}",
    "formulas": [
      "(\\sqrt{A}-B)(\\sqrt{A}+B) = A-B^2"
    ]
  },
  "conjugate_infinity": {
    "name_en": "Conjugate trick at infinity",
    "name_km": "គុណកន្សោមឆ្លាស់នៅអនន្ត",
    "weight": 3,
    "group": "limit",
    "latex": "\\sqrt{A}-B = \\frac{A-B^2}{\\sqrt{A}+B}",
    "formulas": [
      "\\lim_{x\\to\\infty}\\left(\\sqrt{a^2x^2+bx+c}-(ax+d)\\right)=\\frac{b-2ad}{2a}"
    ]
  },
  "indeterminate_one_infinity": {
    "name_en": "Indeterminate form 1^∞ (Euler's number e)",
    "name_km": "លីមីតរាងមិនកំណត់ 1^∞ (ចំនួន e)",
    "weight": 3,
    "group": "limit",
    "latex": "\\lim_{x\\to+\\infty}\\left(1+\\frac{1}{x}\\right)^{x} = e",
    "formulas": [
      "\\lim_{x\\to+\\infty}\\left(1+\\frac{1}{x}\\right)^{x} = e",
      "\\lim_{x\\to 0}(1+x)^{\\frac{1}{x}} = e",
      "\\lim_{x\\to+\\infty}\\left(1+\\frac{1}{u(x)}\\right)^{u(x)} = e \\quad (u(x)\\to+\\infty)",
      "\\lim_{x\\to 0}(1+u(x))^{\\frac{1}{u(x)}} = e \\quad (u(x)\\to 0)",
      "\\lim [f(x)]^{g(x)} = e^{\\lim g(x)(f(x)-1)}"
    ]
  },
  "sinc_standard_limit": {
    "name_en": "Limit formulas of trigonometric functions",
    "name_km": "រូបមន្តលីមីតនៃអនុគមន៍ត្រីកោណមាត្រ",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim_{x\\to 0}\\frac{\\sin x}{x} = 1",
    "formulas": [
      "\\lim_{x\\to 0}\\frac{\\sin x}{x} = 1",
      "\\lim_{x\\to 0}\\frac{\\tan x}{x} = 1",
      "\\lim_{u\\to 0}\\frac{\\sin u}{u} = 1",
      "\\lim_{u\\to 0}\\frac{\\tan u}{u} = 1",
      "\\lim_{x\\to 0}\\frac{1-\\cos x}{x} = 0",
      "\\lim_{x\\to 0}\\frac{\\cos x - 1}{x} = 0"
    ]
  },
  "exponential_standard_limit": {
    "name_en": "Limit formulas of exponential functions",
    "name_km": "រូបមន្តលីមីតនៃអនុគមន៍អិចប៉ូណង់ស្យែល",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim_{x\\to 0}\\frac{e^{x}-1}{x} = 1",
    "formulas": [
      "\\lim_{x\\to+\\infty} e^x = +\\infty",
      "\\lim_{x\\to-\\infty} e^x = 0",
      "\\lim_{x\\to+\\infty}\\frac{x^n}{e^x} = 0 \\quad (n > 0)",
      "\\lim_{x\\to+\\infty}\\frac{e^x}{x^n} = +\\infty \\quad (n > 0)",
      "\\lim_{x\\to 0}\\frac{e^{x}-1}{x} = 1",
      "\\lim_{x\\to 0}\\frac{a^{x}-1}{x} = \\ln a"
    ]
  },
  "log_limit_zero": {
    "name_en": "Limit formulas of logarithmic functions",
    "name_km": "រូបមន្តលីមីតនៃអនុគមន៍ឡូការីតនេពែ",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim_{x\\to 0}\\frac{\\ln(1+x)}{x} = 1",
    "formulas": [
      "\\lim_{x\\to+\\infty}\\ln x = +\\infty",
      "\\lim_{x\\to 0^+}\\ln x = -\\infty",
      "\\lim_{x\\to+\\infty}\\frac{\\ln x}{x} = 0",
      "\\lim_{x\\to 0^+} x\\ln x = 0",
      "\\lim_{x\\to+\\infty}\\frac{\\ln x}{x^n} = 0 \\quad (n \\ge 0)",
      "\\lim_{x\\to 0^+} x^n\\ln x = 0"
    ]
  },
  "trig_double_angle": {
    "name_en": "Double-angle formulas",
    "name_km": "រូបមន្តទ្វេមុំ",
    "weight": 2,
    "group": "limit",
    "latex": "\\sin 2\\alpha = 2\\sin\\alpha\\cos\\alpha",
    "formulas": [
      "\\sin 2\\alpha = 2\\sin\\alpha\\cos\\alpha",
      "\\cos 2\\alpha = \\cos^2\\alpha - \\sin^2\\alpha = 1 - 2\\sin^2\\alpha = 2\\cos^2\\alpha - 1",
      "\\tan 2\\alpha = \\frac{2\\tan\\alpha}{1 - \\tan^2\\alpha} = \\frac{2}{\\cot\\alpha - \\tan\\alpha}",
      "\\cot 2\\alpha = \\frac{\\cot^2\\alpha - 1}{2\\cot\\alpha} = \\frac{\\cot\\alpha - \\tan\\alpha}{2}"
    ]
  },
  "trig_half_angle": {
    "name_en": "Half-angle formulas",
    "name_km": "រូបមន្តកន្លះមុំ",
    "weight": 1,
    "group": "limit",
    "latex": "1 - \\cos\\alpha = 2\\sin^2\\frac{\\alpha}{2}",
    "formulas": [
      "\\sin\\alpha = 2\\sin\\frac{\\alpha}{2}\\cos\\frac{\\alpha}{2}",
      "1 - \\cos\\alpha = 2\\sin^2\\frac{\\alpha}{2}",
      "1 - \\cos 2\\alpha = 2\\sin^2\\alpha",
      "1 + \\cos\\alpha = 2\\cos^2\\frac{\\alpha}{2}"
    ]
  },
  "trig_fundamental_relations": {
    "name_en": "Essential relationships",
    "name_km": "ទំនាក់ទំនងសំខាន់ៗ",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin^2\\alpha + \\cos^2\\alpha = 1",
    "formulas": [
      "\\sin^2\\alpha + \\cos^2\\alpha = 1",
      "\\tan\\alpha \\cdot \\cot\\alpha = 1",
      "\\tan\\alpha = \\frac{\\sin\\alpha}{\\cos\\alpha}",
      "\\cot\\alpha = \\frac{\\cos\\alpha}{\\sin\\alpha}"
    ]
  },
  "trig_triple_quad_angle": {
    "name_en": "Triple-angle formulas",
    "name_km": "រូបមន្តត្រីមុំ",
    "weight": 2,
    "group": "limit",
    "latex": "\\sin 3\\alpha = 3\\sin\\alpha - 4\\sin^3\\alpha",
    "formulas": [
      "\\sin 3\\alpha = 3\\sin\\alpha - 4\\sin^3\\alpha",
      "\\sin 4\\alpha = 4\\sin\\alpha\\cos\\alpha - 8\\sin^3\\alpha\\cos\\alpha",
      "\\cos 3\\alpha = 4\\cos^3\\alpha - 3\\cos\\alpha",
      "\\cos 4\\alpha = 8\\cos^4\\alpha - 8\\cos^2\\alpha + 1",
      "\\tan 3\\alpha = \\frac{3\\tan\\alpha - \\tan^3\\alpha}{1 - 3\\tan^2\\alpha}",
      "\\cot 3\\alpha = \\frac{\\cot^3\\alpha - 3\\cot\\alpha}{3\\cot^2\\alpha - 1}"
    ]
  },
  "trig_power_reducing": {
    "name_en": "Reduction and power-reducing formulas",
    "name_km": "រូបមន្តបន្ថយគណនីត្រីកោណមាត្រ",
    "weight": 2,
    "group": "limit",
    "latex": "\\sin^2\\alpha = \\frac{1-\\cos 2\\alpha}{2}",
    "formulas": [
      "\\sin^2\\alpha = \\frac{1-\\cos 2\\alpha}{2}",
      "\\cos^2\\alpha = \\frac{1+\\cos 2\\alpha}{2}",
      "\\sin^3\\alpha = \\frac{3\\sin\\alpha - \\sin 3\\alpha}{4}",
      "\\cos^3\\alpha = \\frac{3\\cos\\alpha + \\cos 3\\alpha}{4}",
      "\\sin^4\\alpha = \\frac{\\cos 4\\alpha - 4\\cos 2\\alpha + 3}{8}",
      "\\cos^4\\alpha = \\frac{\\cos 4\\alpha + 4\\cos 2\\alpha + 3}{8}",
      "\\sin^5\\alpha = \\frac{10\\sin\\alpha - 5\\sin 3\\alpha + \\sin 5\\alpha}{16}",
      "\\cos^5\\alpha = \\frac{10\\cos\\alpha + 5\\cos 3\\alpha + \\cos 5\\alpha}{16}"
    ]
  },
  "trig_sum_difference": {
    "name_en": "Sum and difference formulas",
    "name_km": "រូបមន្តផលបូកនិងផលដកត្រីកោណមាត្រ",
    "weight": 2,
    "group": "limit",
    "latex": "\\sin(\\alpha \\pm \\beta) = \\sin\\alpha\\cos\\beta \\pm \\sin\\beta\\cos\\alpha",
    "formulas": [
      "\\sin(\\alpha + \\beta) = \\sin\\alpha\\cos\\beta + \\sin\\beta\\cos\\alpha",
      "\\sin(\\alpha - \\beta) = \\sin\\alpha\\cos\\beta - \\sin\\beta\\cos\\alpha",
      "\\cos(\\alpha + \\beta) = \\cos\\alpha\\cos\\beta - \\sin\\alpha\\sin\\beta",
      "\\cos(\\alpha - \\beta) = \\cos\\alpha\\cos\\beta + \\sin\\alpha\\sin\\beta",
      "\\tan(\\alpha + \\beta) = \\frac{\\tan\\alpha + \\tan\\beta}{1 - \\tan\\alpha\\tan\\beta}",
      "\\tan(\\alpha - \\beta) = \\frac{\\tan\\alpha - \\tan\\beta}{1 + \\tan\\alpha\\tan\\beta}",
      "\\cot(\\alpha + \\beta) = \\frac{1 - \\tan\\alpha\\tan\\beta}{\\tan\\alpha + \\tan\\beta}",
      "\\cot(\\alpha - \\beta) = \\frac{1 + \\tan\\alpha\\tan\\beta}{\\tan\\alpha - \\tan\\beta}"
    ]
  },
  "trig_sum_to_product": {
    "name_en": "Sum-to-product formulas",
    "name_km": "រូបមន្តបម្លែងផលបូក",
    "weight": 2,
    "group": "limit",
    "latex": "\\cos\\alpha - \\cos\\beta = -2\\sin\\frac{\\alpha+\\beta}{2}\\sin\\frac{\\alpha-\\beta}{2}",
    "formulas": [
      "\\sin\\alpha + \\sin\\beta = 2\\sin\\frac{\\alpha+\\beta}{2}\\cos\\frac{\\alpha-\\beta}{2}",
      "\\sin\\alpha - \\sin\\beta = 2\\cos\\frac{\\alpha+\\beta}{2}\\sin\\frac{\\alpha-\\beta}{2}",
      "\\cos\\alpha + \\cos\\beta = 2\\cos\\frac{\\alpha+\\beta}{2}\\cos\\frac{\\alpha-\\beta}{2}",
      "\\cos\\alpha - \\cos\\beta = -2\\sin\\frac{\\alpha+\\beta}{2}\\sin\\frac{\\alpha-\\beta}{2}"
    ]
  },
  "trig_periodicity": {
    "name_en": "Relationship between alpha and alpha + 2k*pi",
    "name_km": "ទំនាក់ទំនងរវាង \\alpha និង \\alpha + 2k\\pi",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin(\\alpha + 2k\\pi) = \\sin\\alpha",
    "formulas": [
      "\\sin(\\alpha + 2k\\pi) = \\sin\\alpha",
      "\\cos(\\alpha + 2k\\pi) = \\cos\\alpha",
      "\\tan(\\alpha + 2k\\pi) = \\tan\\alpha",
      "\\cot(\\alpha + 2k\\pi) = \\cot\\alpha"
    ]
  },
  "trig_opposite_angles": {
    "name_en": "Opposite angles alpha and -alpha",
    "name_km": "មុំផ្ទុយគ្នា \\alpha និង -\\alpha",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin(-\\alpha) = -\\sin\\alpha",
    "formulas": [
      "\\sin(-\\alpha) = -\\sin\\alpha",
      "\\cos(-\\alpha) = \\cos\\alpha",
      "\\tan(-\\alpha) = -\\tan\\alpha",
      "\\cot(-\\alpha) = -\\cot\\alpha"
    ]
  },
  "trig_angles_sum_pi": {
    "name_en": "Angles with sum pi",
    "name_km": "មុំដែលមានផលបូកស្មើ \\pi",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin(\\pi + \\alpha) = -\\sin\\alpha",
    "formulas": [
      "\\sin(\\pi + \\alpha) = -\\sin\\alpha",
      "\\cos(\\pi + \\alpha) = -\\cos\\alpha",
      "\\tan(\\pi + \\alpha) = \\tan\\alpha",
      "\\cot(\\pi + \\alpha) = \\cot\\alpha"
    ]
  },
  "trig_supplementary_angles": {
    "name_en": "Supplementary angles",
    "name_km": "មុំបំពេញបន្ថែម",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin(\\pi - \\alpha) = \\sin\\alpha",
    "formulas": [
      "\\sin(\\pi - \\alpha) = \\sin\\alpha",
      "\\cos(\\pi - \\alpha) = -\\cos\\alpha",
      "\\tan(\\pi - \\alpha) = -\\tan\\alpha",
      "\\cot(\\pi - \\alpha) = -\\cot\\alpha"
    ]
  },
  "trig_complementary_angles": {
    "name_en": "Complementary angles pi/2 - alpha",
    "name_km": "មុំបំពេញ \\frac{\\pi}{2} - \\alpha",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin(\\frac{\\pi}{2} - \\alpha) = \\cos\\alpha",
    "formulas": [
      "\\sin(\\frac{\\pi}{2} - \\alpha) = \\cos\\alpha",
      "\\cos(\\frac{\\pi}{2} - \\alpha) = \\sin\\alpha",
      "\\tan(\\frac{\\pi}{2} - \\alpha) = \\cot\\alpha",
      "\\cot(\\frac{\\pi}{2} - \\alpha) = \\tan\\alpha"
    ]
  },
  "trig_angles_sum_half_pi": {
    "name_en": "Angles with sum pi/2",
    "name_km": "មុំដែលមានផលបូកស្មើ \\frac{\\pi}{2}",
    "weight": 1,
    "group": "limit",
    "latex": "\\sin(\\frac{\\pi}{2} + \\alpha) = \\cos\\alpha",
    "formulas": [
      "\\sin(\\frac{\\pi}{2} + \\alpha) = \\cos\\alpha",
      "\\cos(\\frac{\\pi}{2} + \\alpha) = -\\sin\\alpha",
      "\\tan(\\frac{\\pi}{2} + \\alpha) = -\\cot\\alpha",
      "\\cot(\\frac{\\pi}{2} + \\alpha) = -\\tan\\alpha"
    ]
  },
  "trig_special_angles_table": {
    "name_en": "Table of special angles for trigonometric functions",
    "name_km": "តារាងមុំពិសេសនៃអនុគមន៍ត្រីកោណមាត្រ",
    "weight": 1,
    "group": "limit",
    "latex": "0^\\circ, 30^\\circ, 45^\\circ, 60^\\circ, 90^\\circ, 120^\\circ, 135^\\circ, 150^\\circ, 180^\\circ",
    "formulas": [
      "\\sin(0)=0, \\sin(30^\\circ)=\\frac{1}{2}, \\sin(45^\\circ)=\\frac{\\sqrt{2}}{2}, \\sin(60^\\circ)=\\frac{\\sqrt{3}}{2}, \\sin(90^\\circ)=1",
      "\\cos(0)=1, \\cos(30^\\circ)=\\frac{\\sqrt{3}}{2}, \\cos(45^\\circ)=\\frac{\\sqrt{2}}{2}, \\cos(60^\\circ)=\\frac{1}{2}, \\cos(90^\\circ)=0",
      "\\tan(0)=0, \\tan(30^\\circ)=\\frac{\\sqrt{3}}{3}, \\tan(45^\\circ)=1, \\tan(60^\\circ)=\\sqrt{3}",
      "\\cot(30^\\circ)=\\sqrt{3}, \\cot(45^\\circ)=1, \\cot(60^\\circ)=\\frac{\\sqrt{3}}{3}, \\cot(90^\\circ)=0"
    ]
  },
  "euler_identify_form": {
    "name_en": "Identify indeterminate form 1^inf",
    "name_km": "ផ្ទៀងផ្ទាត់រាងមិនកំណត់ 1^អនន្ត",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim [f(x)]^{g(x)} \\to 1^{\\infty}",
    "formulas": [
      "\\lim [f(x)]^{g(x)} \\to 1^{\\infty}"
    ]
  },
  "euler_base_minus_one": {
    "name_en": "Compute base deviation f(x) - 1",
    "name_km": "គណនា f(x) - 1",
    "weight": 2,
    "group": "limit",
    "latex": "u(x) = f(x) - 1",
    "formulas": [
      "u(x) = f(x) - 1"
    ]
  },
  "euler_exponent_limit": {
    "name_en": "Evaluate exponent product limit",
    "name_km": "គណនាលីមីតស្វ័យគុណ g(x)(f(x) - 1)",
    "weight": 3,
    "group": "limit",
    "latex": "L = \\lim g(x)(f(x) - 1)",
    "formulas": [
      "L = \\lim g(x)(f(x) - 1)"
    ]
  },
  "euler_final_exp": {
    "name_en": "Conclude with exponential result e^L",
    "name_km": "សន្និដ្ឋានតម្លៃលីមីតចុងក្រោយ e^L",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim [f(x)]^{g(x)} = e^L",
    "formulas": [
      "\\lim [f(x)]^{g(x)} = e^L"
    ]
  },
  "limit_power_identity": {
    "name_en": "Power difference limit identity",
    "name_km": "រូបមន្តលីមីតស្វ័យគុណ x^n - a^n",
    "weight": 2,
    "group": "limit",
    "latex": "\\lim_{x\\to a}\\frac{x^n-a^n}{x-a} = n a^{n-1}",
    "formulas": [
      "\\lim_{x\\to a}\\frac{x^n-a^n}{x-a} = n a^{n-1}",
      "\\lim_{x\\to a}\\frac{x^p-a^p}{x^q-a^q} = \\frac{p a^{p-1}}{q a^{q-1}}"
    ]
  },
  "unclassified_valid": {
    "name_en": "Valid algebraic step",
    "name_km": "ជំហានពិជគណិតត្រឹមត្រូវ (មិនទាន់ចាត់ថ្នាក់)",
    "weight": 1,
    "group": "limit",
    "latex": "A = B",
    "formulas": [
      "A = B"
    ]
  }
}