    ]
  },
  "angle_addition_0_0": {
    "name_en": "Angle-addition identity",
    "name_km": "រូបមន្តបូកមុំត្រីកោណមាត្រ 0/0",
    "weight": 2,
    "group": "limit",
    "latex": "\\sin(a\\pm b) = \\sin a\\cos b \\pm \\cos a\\sin b",
    "formulas": [
