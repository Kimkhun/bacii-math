# Copy to backend/.env and fill in as needed.
# Used when running the backend directly (uvicorn); Docker Compose sets most
# of these itself in docker-compose.yml (pointing at the postgres/redis
# services and host.docker.internal for Ollama).

# --- Database / cache ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bacii
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Generate a real secret in production, e.g.: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Gemini (Vertex AI) — explanations ---
# Optional: without a valid service account, explanations fall back to Ollama,
# then to deterministic SymPy-generated text.
GEMINI_PROJECT=
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Path to the downloaded Vertex AI service account JSON key (gitignored).
GOOGLE_APPLICATION_CREDENTIALS=backend/credentials/gemini-service-account.json
GEMINI_RATE_LIMIT_PER_MINUTE=10

# --- Ollama — handwriting OCR + local explanation fallback ---
OLLAMA_URL=http://localhost:11434/api/generate
VISION_MODEL=qwen2.5vl:3b
TEXT_MODEL=qwen2.5:3b

# --- Misc ---
EXPLANATION_CACHE_TTL_SECONDS=86400
