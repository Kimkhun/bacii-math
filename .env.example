# Copy to .env (repo root) — Docker Compose reads this automatically and
# substitutes every ${VAR:-default} placeholder in docker-compose.yml.
# Nothing here is required; each has a working default for local dev.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bacii
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Host ports ---
BACKEND_PORT=8016
WEB_PORT=3016

# --- Auth ---
# Generate a real secret in production, e.g.: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Gemini (Vertex AI) — explanations ---
# Optional: without a valid service account, explanations fall back to Ollama,
# then to deterministic SymPy-generated text.
GEMINI_PROJECT=
GEMINI_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
GEMINI_RATE_LIMIT_PER_MINUTE=10
# Also place your Vertex AI service account key at:
#   backend/credentials/gemini-service-account.json
# (gitignored; mounted read-only into the backend container automatically)

# --- Ollama — handwriting OCR + local explanation fallback ---
# Must run on the HOST; the backend container reaches it via host.docker.internal.
OLLAMA_URL=http://host.docker.internal:11434/api/generate
VISION_MODEL=qwen2.5vl:3b
TEXT_MODEL=qwen2.5:3b

# --- Misc ---
EXPLANATION_CACHE_TTL_SECONDS=86400

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8016
